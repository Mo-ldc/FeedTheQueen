CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.01 }
        effectParams: { value: [0, 0, 1, 1] }
        effectTime: { value: [0, 0, 0, 0] }
        edgeColor: { value: [1, 1, 1, 1] }
        noiseTexture: { value: white }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;

  #if USE_TEXTURE
    in vec2 uv0;
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  uniform OriginalUniforms {vec4 effectParams;vec4 effectTime;vec4 edgeColor;};
  uniform sampler2D noiseTexture;
  vec3 rgb2hsv(vec3 c){vec4 K=vec4(0.0,-1.0/3.0,2.0/3.0,-1.0);vec4 p=mix(vec4(c.bg,K.wz),vec4(c.gb,K.xy),step(c.b,c.g));vec4 q=mix(vec4(p.xyw,c.r),vec4(c.r,p.yzx),step(p.x,c.r));float d=q.x-min(q.w,q.y);float e=1.0e-10;return vec3(abs(q.z+(q.w-q.y)/(6.0*d+e)),d/(q.x+e),q.x);}
  vec3 hsv2rgb(vec3 c){vec4 K=vec4(1.0,2.0/3.0,1.0/3.0,3.0);vec3 p=abs(fract(c.xxx+K.xyz)*6.0-K.www);return c.z*mix(K.xxx,clamp(p-K.xxx,0.0,1.0),c.y);}
  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      vec2 sampleUV=uv0;
      if(effectParams.x>3.5&&effectParams.x<4.5){vec2 noiseUV=(uv0-0.5)*vec2(7078.0,4052.0)/(512.0*effectParams.z);vec2 offset=vec2(floor(effectTime.x*effectParams.w))*vec2(3.14159265,2.71828183);float angle=texture(noiseTexture,noiseUV+offset).r*12.56637061;sampleUV+=vec2(cos(angle),sin(angle))*effectParams.y*0.005;}
      o *= CCSampleWithAlphaSeparated(cc_spriteTexture, sampleUV);
      if(effectParams.x>4.5){vec2 d=effectParams.yz;o*=0.25;o+=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0+vec2(d.x,0.0))*0.125;o+=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0-vec2(d.x,0.0))*0.125;o+=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0+vec2(0.0,d.y))*0.125;o+=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0-vec2(0.0,d.y))*0.125;o+=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0+d)*0.0625;o+=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0-d)*0.0625;o+=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0+vec2(d.x,-d.y))*0.0625;o+=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0+vec2(-d.x,d.y))*0.0625;}
      #if IS_GRAY
        float gray  = 0.2126 * o.r + 0.7152 * o.g + 0.0722 * o.b;
        o.r = o.g = o.b = gray;
      #endif
    #endif

    if(effectParams.x<0.5){vec3 hsv=rgb2hsv(o.rgb);hsv.x=fract(hsv.x+effectParams.y);hsv.y=min(hsv.y*effectParams.z,1.01);hsv.z=min(hsv.z*effectParams.w,1.01);o.rgb=hsv2rgb(hsv);}
    else if(effectParams.x<1.5){float sn=sin(effectParams.z),cs=cos(effectParams.z),len=abs(sn)+abs(cs);vec2 p=(uv0-vec2(0.5))/len;float dist=(p.x*sn+p.y*cs+0.5)*(1.0-effectParams.w);o.a=max(0.0,o.a-step(effectParams.y,dist));o.rgb=mix(o.rgb,edgeColor.rgb,step(effectParams.y,dist+effectParams.w));}
    else if(effectParams.x<2.5){vec2 uv=uv0;vec3 rainbow=0.5+0.5*sin(vec3(uv.x*15.0,uv.y*15.0+2.0,uv.x*10.0+4.0)+effectTime.x*0.1);o.rgb=mix(o.rgb,rainbow,effectParams.y);}
    else if(effectParams.x<3.5) {o.rgb=vec3(dot(o.rgb,vec3(0.299,0.587,0.114)));}
    o *= color;
    ALPHA_TEST(o);
    return o;
  }
}%
